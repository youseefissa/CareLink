@page "/patient/{PatientProfileId:guid}"
@attribute [Authorize]
@inject ApiClient ApiClient
@using CareLink.Dashboard.Models

<PageTitle>@(_profile?.FullName ?? "تفاصيل المريض") - CareLink AI</PageTitle>

@if (_isLoading)
{
    <p>جاري تحميل البيانات...</p>
}
else if (_profile is null)
{
    <div class="empty-state">
        <p>تعذر تحميل بيانات هذا المريض.</p>
    </div>
}
else
{
    <a href="/" class="back-link">← رجوع للمرضى</a>

    <h1 class="page-title">@_profile.FullName</h1>

    <section class="detail-section">
        <h2 class="section-heading">التنبيهات غير المحلولة</h2>

        @if (_alerts.Count(a => !a.IsResolved) == 0)
        {
            <p class="section-empty">لا توجد تنبيهات مفتوحة حاليًا.</p>
        }
        else
        {
            <div class="alerts-list">
                @foreach (var alert in _alerts.Where(a => !a.IsResolved))
                {
                    <div class="alert-row severity-@alert.Severity">
                        <div class="alert-info">
                            <span class="alert-message">@alert.Message</span>
                            <span class="alert-time">@alert.CreatedAt.ToString("dd MMM, HH:mm")</span>
                        </div>
                        <button class="btn-resolve" @onclick="() => ResolveAlertAsync(alert.Id)" disabled="@_processingIds.Contains(alert.Id)">
                            @(_processingIds.Contains(alert.Id) ? "جاري الحل..." : "تم الحل")
                        </button>
                    </div>
                }
            </div>
        }
    </section>

    <section class="detail-section">
        <h2 class="section-heading">سجل الأحداث الزمني</h2>

        <div class="timeline">
            @foreach (var entry in BuildTimeline())
            {
                <div class="timeline-entry timeline-@entry.Kind">
                    <span class="timeline-marker"></span>
                    <div class="timeline-content">
                        <span class="timeline-label">@entry.Label</span>
                        <span class="timeline-time">@entry.When.ToString("dd MMM yyyy, HH:mm")</span>
                    </div>
                </div>
            }

            @if (!BuildTimeline().Any())
            {
                <p class="section-empty">لا يوجد أي أحداث مسجلة حتى الآن.</p>
            }
        </div>
    </section>

    <section class="detail-section">
        <h2 class="section-heading">التوصيات الوقائية</h2>

        @if (_recommendations.Count == 0)
        {
            <p class="section-empty">لا توجد توصيات حاليًا.</p>
        }
        else
        {
            <div class="recommendations-list">
                @foreach (var rec in _recommendations)
                {
                    <div class="recommendation-row @(rec.IsAcknowledged ? "acknowledged" : "")">
                        <span>@rec.RecommendationText</span>

                        @if (!rec.IsAcknowledged)
                        {
                            <button class="btn-ack" @onclick="() => AcknowledgeRecommendationAsync(rec.Id)" disabled="@_processingIds.Contains(rec.Id)">
                                @(_processingIds.Contains(rec.Id) ? "جاري..." : "تم الاطلاع")
                            </button>
                        }
                    </div>
                }
            </div>
        }
    </section>

    <section class="detail-section">
        <div class="section-header-row">
            <h2 class="section-heading">التقارير الدورية</h2>
            <button class="btn-secondary" @onclick="GenerateReportAsync" disabled="@_isGeneratingReport">
                @(_isGeneratingReport ? "جاري الإنشاء..." : "إنشاء تقرير آخر 30 يوم")
            </button>
        </div>

        @if (_reportErrors.Any())
        {
            <div class="form-errors">
                @foreach (var error in _reportErrors)
                {
                    <p>@error</p>
                }
            </div>
        }

        @if (_reports.Count == 0)
        {
            <p class="section-empty">لا توجد تقارير سابقة.</p>
        }
        else
        {
            <div class="reports-list">
                @foreach (var report in _reports)
                {
                    <div class="report-row">
                        <div class="report-period">
                            @report.PeriodStart.ToString("dd MMM") - @report.PeriodEnd.ToString("dd MMM yyyy")
                        </div>
                        <div class="report-stats">
                            <span>عدد مرات السقوط: @report.TotalFalls</span>
                            <span>متوسط النشاط اليومي: @report.AverageDailyActivity.ToString("0.0")</span>
                            <span>تنبيهات انعدام الحركة: @report.InactivityEventsCount</span>
                        </div>
                    </div>
                }
            </div>
        }
    </section>
}

@code {
    [Parameter] public Guid PatientProfileId { get; set; }

    private PatientProfileDetail? _profile;
    private List<AlertItem> _alerts = new();
    private List<FallEventItem> _fallEvents = new();
    private List<SOSEventItem> _sosEvents = new();
    private List<ActivityLogItem> _activityLogs = new();
    private List<SafetyRecommendationItem> _recommendations = new();
    private List<TrendReportItem> _reports = new();
    private List<string> _reportErrors = new();
    private HashSet<Guid> _processingIds = new();
    private bool _isLoading = true;
    private bool _isGeneratingReport;

    protected override async Task OnInitializedAsync()
    {
        await LoadAllDataAsync();
    }

    private async Task LoadAllDataAsync()
    {
        var (profileSuccess, profileData, _) = await ApiClient.GetAsync<PatientProfileDetail>(
            $"api/patient/profile/{PatientProfileId}");

        if (profileSuccess && profileData is not null)
        {
            _profile = profileData;

            var (alertsOk, alertsData, _) = await ApiClient.GetAsync<List<AlertItem>>(
                $"api/alert/patient/{PatientProfileId}");
            if (alertsOk && alertsData is not null) _alerts = alertsData;

            var (fallsOk, fallsData, _) = await ApiClient.GetAsync<List<FallEventItem>>(
                $"api/fall/patient/{PatientProfileId}/history");
            if (fallsOk && fallsData is not null) _fallEvents = fallsData;

            var (sosOk, sosData, _) = await ApiClient.GetAsync<List<SOSEventItem>>(
                $"api/sos/patient/{PatientProfileId}/history");
            if (sosOk && sosData is not null) _sosEvents = sosData;

            var (activityOk, activityData, _) = await ApiClient.GetAsync<List<ActivityLogItem>>(
                $"api/activitylog/patient/{PatientProfileId}/history");
            if (activityOk && activityData is not null) _activityLogs = activityData;

            var (recOk, recData, _) = await ApiClient.GetAsync<List<SafetyRecommendationItem>>(
                $"api/safetyrecommendation/patient/{PatientProfileId}");
            if (recOk && recData is not null) _recommendations = recData;

            var (reportsOk, reportsData, _) = await ApiClient.GetAsync<List<TrendReportItem>>(
                $"api/trendreport/patient/{PatientProfileId}/history");
            if (reportsOk && reportsData is not null) _reports = reportsData;
        }

        _isLoading = false;
    }

    private async Task ResolveAlertAsync(Guid alertId)
    {
        _processingIds.Add(alertId);

        var (success, _) = await ApiClient.PostAsync($"api/alert/{alertId}/resolve", new { });

        if (success)
        {
            var alert = _alerts.FirstOrDefault(a => a.Id == alertId);
            if (alert is not null) alert.IsResolved = true;
        }

        _processingIds.Remove(alertId);
    }

    private async Task AcknowledgeRecommendationAsync(Guid recommendationId)
    {
        _processingIds.Add(recommendationId);

        var (success, _) = await ApiClient.PostAsync($"api/safetyrecommendation/{recommendationId}/acknowledge", new { });

        if (success)
        {
            var rec = _recommendations.FirstOrDefault(r => r.Id == recommendationId);
            if (rec is not null) rec.IsAcknowledged = true;
        }

        _processingIds.Remove(recommendationId);
    }

    private async Task GenerateReportAsync()
    {
        _isGeneratingReport = true;
        _reportErrors.Clear();

        var periodEnd = DateTime.UtcNow;
        var periodStart = periodEnd.AddDays(-30);

        var (success, data, errors) = await ApiClient.PostAsync<TrendReportItem>("api/trendreport/generate", new
        {
            patientProfileId = PatientProfileId,
            periodStart,
            periodEnd
        });

        if (success && data is not null)
        {
            _reports.Insert(0, data);
        }
        else
        {
            _reportErrors = errors;
        }

        _isGeneratingReport = false;
    }

    private List<TimelineEntry> BuildTimeline()
    {
        var entries = new List<TimelineEntry>();

        entries.AddRange(_fallEvents.Where(f => f.IsFall).Select(f => new TimelineEntry
        {
            Kind = "fall",
            Label = $"تم رصد سقوط بنسبة ثقة {f.Confidence:P0}",
            When = f.CreatedAt
        }));

        entries.AddRange(_sosEvents.Select(s => new TimelineEntry
        {
            Kind = "sos",
            Label = $"تفعيل حالة طوارئ عبر {s.TriggerSource}",
            When = s.CreatedAt
        }));

        entries.AddRange(_activityLogs.Take(20).Select(a => new TimelineEntry
        {
            Kind = "activity",
            Label = $"نشاط: {a.ActivityType}",
            When = a.OccurredAt
        }));

        return entries.OrderByDescending(e => e.When).ToList();
    }

    private class TimelineEntry
    {
        public string Kind { get; set; } = string.Empty;
        public string Label { get; set; } = string.Empty;
        public DateTime When { get; set; }
    }
}